# Docker Compose
APP_PORT=8080
POSTGRES_DB=llm_voice_agent
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST_PORT=5432
REDIS_MAXMEMORY=512mb
REDIS_HOST_PORT=6379

# Application
ENVIRONMENT=local
DEBUG=false
CORS_ORIGINS=http://localhost:8080
APP_API_KEY=
ENFORCE_API_KEY_AUTH_IN_LOCAL=false
AUTH_SESSION_HOURS=12
AUTH_SESSION_REDIS_PREFIX=llm_voice_agent:admin_session
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Docker service names are used as hosts inside the Compose network.
DATABASE_URL=postgresql+asyncpg://dev_user:dev_password@postgres:5432/llm_voice_agent
REDIS_URL=redis://redis:6379/0
TWILIO_RUNTIME_STORE_BACKEND=redis

# LLM
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_LIVE_PROVIDER=gemini
DEFAULT_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
DEFAULT_LIVE_MODALITIES=AUDIO
DEFAULT_LIVE_VOICE=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_IDENTITY=webcall-tester
TWILIO_DEFAULT_PROMPT_CODE=base_appointment
TWILIO_VALIDATE_WEBHOOKS=true
TWILIO_WEBHOOK_TOLERANCE_SECONDS=300
TWILIO_MEDIA_STREAM_DEBUG_INBOUND_WAV_ENABLED=false
