# Environment
ENVIRONMENT=local
DEBUG=false

# Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_API_KEY=
ENFORCE_API_KEY_AUTH_IN_LOCAL=false

# Database
DATABASE_URL=postgresql+asyncpg://dev_user:dev_password@localhost:5432/llm_voice_agent

# LLM (Google Gemini)
GOOGLE_API_KEY=your-google-api-key
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.0-flash
DEFAULT_LIVE_MODEL=gemini-3.1-flash-live-preview
DEFAULT_LIVE_MODALITIES=AUDIO
DEFAULT_LIVE_VOICE=

# Twilio (optional for WebCall)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_IDENTITY=webcall-tester
TWILIO_VALIDATE_WEBHOOKS=true
TWILIO_WEBHOOK_TOLERANCE_SECONDS=300
