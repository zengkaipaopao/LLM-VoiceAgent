# Environment
ENVIRONMENT=local
DEBUG=false

# Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_API_KEY=
ENFORCE_API_KEY_AUTH_IN_LOCAL=false

# Database
DATABASE_URL=postgresql+asyncpg://dev_user:dev_password@localhost:5432/llm_voice_agent
REDIS_URL=redis://localhost:6379/0

# LLM (Google Gemini)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_LIVE_PROVIDER=gemini
DEFAULT_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
DEFAULT_LIVE_MODALITIES=AUDIO
DEFAULT_LIVE_VOICE=

# Twilio (optional for WebCall)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_DEFAULT_IDENTITY=webcall-tester
TWILIO_DEFAULT_PROMPT_CODE=base_appointment
TWILIO_OFFICIAL_DEMO_MODEL=gemini-2.5-flash-native-audio-latest
TWILIO_OFFICIAL_DEMO_VOICE=Aoede
TWILIO_OFFICIAL_DEMO_INSTRUCTION=あなたは日本語の電話受付AIです。自然で簡潔な音声会話を行い、ユーザーの用件を一つずつ確認してください。通話が始まったら最初に短く挨拶し、その後は相手の発話を待ってください。余計な説明、メタ発言、英語の見出しは出力しないでください。
TWILIO_OFFICIAL_CA_AGENT_ID=projects/llmvoiceagents/locations/global/agents/agent_1776670864754
TWILIO_OFFICIAL_CA_DEPLOYMENT_ID=
TWILIO_OFFICIAL_CA_ENVIRONMENT=draft
TWILIO_OFFICIAL_CA_KICKSTART_TEXT=こんにちは
# Format: +815012345678:base_appointment,+815076543210:cancel_intent
TWILIO_INCOMING_PROMPT_MAP=
TWILIO_INCOMING_DEFAULT_MODE=agent
TWILIO_INCOMING_VOICE_ENGINE=twilio
# Gemini stream activity boundary mode:
# - auto   : Gemini automatic activity detection
# - manual : backend VAD + explicit activityStart/activityEnd
TWILIO_GEMINI_ACTIVITY_MODE=auto
TWILIO_GEMINI_ACTIVITY_HANDLING=interrupt
TWILIO_GEMINI_TURN_COVERAGE=activity_only
TWILIO_GEMINI_START_SENSITIVITY=low
TWILIO_GEMINI_END_SENSITIVITY=low
TWILIO_GEMINI_PREFIX_PADDING_MS=100
TWILIO_GEMINI_SILENCE_DURATION_MS=800
TWILIO_GREETING_INTERRUPT_GUARD_MS=900
TWILIO_MEDIA_STREAM_INBOUND_BATCH_MS=20
TWILIO_MEDIA_STREAM_INPUT_NOISE_GATE_ENABLED=true
TWILIO_MEDIA_STREAM_INPUT_NOISE_GATE_OPEN_RMS=140
TWILIO_MEDIA_STREAM_INPUT_NOISE_GATE_CLOSE_RMS=90
TWILIO_MEDIA_STREAM_INPUT_NOISE_GATE_HOLD_MS=240
TWILIO_MEDIA_STREAM_PLAYBACK_CLEAR_RMS=120
TWILIO_MEDIA_STREAM_PLAYBACK_CLEAR_MIN_HITS=3
TWILIO_MEDIA_STREAM_PLAYBACK_OVERLAP_BUFFER_MS=800
TWILIO_MEDIA_STREAM_UPSTREAM_ACTIVITY_RMS=48
TWILIO_MEDIA_STREAM_PAUSE_FLUSH_SECONDS=1.0
TWILIO_MEDIA_STREAM_DEBUG_INBOUND_WAV_ENABLED=true
TWILIO_MEDIA_STREAM_DEBUG_INBOUND_WAV_SECONDS=5
# Runtime store backend for Twilio Media Streams:
# - memory : single-process default
# - redis  : shared backend for multi-process / longer-lived state
TWILIO_RUNTIME_STORE_BACKEND=memory
TWILIO_AGENT_LANGUAGE=ja-JP
TWILIO_STRICT_TEMPLATE_PROVIDER=true
TWILIO_VALIDATE_WEBHOOKS=true
TWILIO_WEBHOOK_TOLERANCE_SECONDS=300
